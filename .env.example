# Пример переменных окружения. Скопируйте в backend/.env и замените значения.
# Сгенерируйте надёжный SECRET_KEY, например:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DATABASE_URL=postgresql+asyncpg://media:media_secret@localhost:5433/media_db
SECRET_KEY=please-change-me-to-a-strong-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
UPLOAD_DIR=uploads
